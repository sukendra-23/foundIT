# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://foundit-production-2e271b5d.up.railway.app

# MySQL Database Configuration (App User - used at runtime)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_NAME=lost_and_found

# Authentication Secrets (REQUIRED on Railway / Production)
# Must be a secure, high-entropy random string (at least 32 characters recommended)
# e.g. generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Email Service Configuration (Required for OTP email delivery in production)
# Option A: Brevo API (Recommended — sign up at brevo.com for free 300 emails/day)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=verified_sender@yourdomain.com
EMAIL_FROM_NAME=FoundIT

# Option B: Resend API (Alternative — sign up at resend.com)
# RESEND_API_KEY=re_your_resend_api_key_here

# External APIs
# CLOUDINARY_URL=your_cloudinary_url_here
